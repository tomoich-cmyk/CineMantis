{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CineMantis default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-recursive",
    "fs:allow-read-file",
    "shell:default"
  ]
}

# Normalize line endings
* text=auto eol=lf

# Rust
*.rs text eol=lf

# Web
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binary
*.png binary
*.ico binary
*.icns binary
